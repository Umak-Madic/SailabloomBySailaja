@page
@model Sailabloom.Web.Pages.Admin.IssueReports.IndexModel
@{
    ViewData["Title"] = "Admin — Issue reports";
}

<section class="page-section">
    <h1>Issue reports</h1>

    <nav class="admin-nav" aria-label="Admin">
        <a asp-page="/Admin/Index">Dashboard</a>
        <a asp-page="/Admin/Plants/Index">Plants &amp; stock</a>
        <a asp-page="/Admin/Orders/Index">Orders</a>
        <a asp-page="/Admin/IssueReports/Index">Issue reports</a>
        <a asp-page="/Admin/Reports/Index">Sales reports</a>
    </nav>

    @if (Model.Reports.Count == 0)
    {
        <div class="card"><p class="muted">No problem reports — every plant arrived alive. 🌿</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Order</th>
                    <th>Issue</th>
                    <th>Description</th>
                    <th>Photo</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model.Reports)
                {
                    <tr>
                        <td>@report.CreatedUtc.ToLocalTime().ToString("g")</td>
                        <td>#@report.OrderId<br /><span class="muted">@report.ContactEmail</span></td>
                        <td>@report.IssueType</td>
                        <td>@report.Description</td>
                        <td>@(report.PhotoFileName ?? "—")</td>
                        <td>@report.Status</td>
                        <td><a class="btn btn-secondary btn-small" asp-page="/Admin/Orders/Details" asp-route-id="@report.OrderId">Open order</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
