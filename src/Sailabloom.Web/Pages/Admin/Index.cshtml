@page
@model Sailabloom.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
}

<section class="page-section">
    <h1>Admin</h1>

    <nav class="admin-nav" aria-label="Admin">
        <a asp-page="/Admin/Plants/Index">Plants &amp; stock</a>
        <a asp-page="/Admin/Orders/Index">Orders</a>
        <a asp-page="/Admin/IssueReports/Index">Issue reports</a>
        <a asp-page="/Admin/Reports/Index">Sales reports</a>
    </nav>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-label">Gross sales</div>
            <div class="stat-value">@Model.Summary.Gross.ToString("C")</div>
        </div>
        <div class="stat-card refunds">
            <div class="stat-label">Total refunds</div>
            <div class="stat-value">@Model.Summary.Refunds.ToString("C")</div>
        </div>
        <div class="stat-card net">
            <div class="stat-label">NET sales</div>
            <div class="stat-value">@Model.Summary.Net.ToString("C")</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Orders</div>
            <div class="stat-value">@Model.Summary.OrderCount</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Open issue reports</div>
            <div class="stat-value">@Model.OpenIssueReports</div>
        </div>
    </div>

    <div class="card">
        <h2>Quick links</h2>
        <p><a asp-page="/Admin/Plants/Create">Add a new plant</a> · <a asp-page="/Admin/Orders/Index">Review orders, refunds &amp; replacements</a> · <a asp-page="/Admin/Reports/Index">Month-wise sales reports</a></p>
        <p class="muted">Sales Reports live only here in the Admin area — customers never see them in the store banner.</p>
    </div>
</section>
