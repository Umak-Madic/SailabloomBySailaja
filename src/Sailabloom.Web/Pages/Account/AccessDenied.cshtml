@page
@model Sailabloom.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<section class="page-section">
    <div class="card">
        <h1>Access denied</h1>
        <p>The Admin area is for the store owner only. If that's you, please sign in with the admin account.</p>
        <p><a class="btn btn-primary" asp-page="/Account/Login">Go to sign-in</a></p>
    </div>
</section>
