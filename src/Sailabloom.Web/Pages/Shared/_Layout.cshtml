@using Sailabloom.Web.Services
@inject CartService CartService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sailabloom by Sailaja</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-page="/Index">
                <svg class="icon brand-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22c6-2 9-7 9-14V4h-4C10 4 5 8 3.6 14.6 3.2 16.6 3.6 19 5 21c.5.7 1.6.4 1.9-.4C8.2 16.9 10.6 13.6 14 11c-3.8 3.2-6.4 6.8-7.7 10.4 1.5.8 3.8 1.1 5.7.6z" fill="currentColor"/></svg>
                <span class="brand-text">
                    <span class="brand-name">Sailabloom</span>
                    <span class="brand-sub">by Sailaja</span>
                </span>
            </a>
            <nav class="main-nav" aria-label="Main">
                <a asp-page="/Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.2 12 3l9 8.2V21a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" fill="currentColor"/></svg>
                    <span>Home</span>
                </a>
                <a asp-page="/Shop">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22c6-2 9-7 9-14V4h-4C10 4 5 8 3.6 14.6 3.2 16.6 3.6 19 5 21c.5.7 1.6.4 1.9-.4C8.2 16.9 10.6 13.6 14 11c-3.8 3.2-6.4 6.8-7.7 10.4 1.5.8 3.8 1.1 5.7.6z" fill="currentColor"/></svg>
                    <span>Shop</span>
                </a>
                <a asp-page="/Guarantee">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5zm-1.2 13.6-4-4 1.4-1.4 2.6 2.6 5-5 1.4 1.4z" fill="currentColor"/></svg>
                    <span>Guarantee</span>
                </a>
                <a asp-page="/Cart">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a2 2 0 1 0 .1 4A2 2 0 0 0 7 18zm10 0a2 2 0 1 0 .1 4A2 2 0 0 0 17 18zM3 2h3l2.6 12.4A2 2 0 0 0 10.6 16h7.9a2 2 0 0 0 2-1.6L22 6H6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>Cart</span>
                    @if (CartService.GetCount() > 0)
                    {
                        <span class="cart-badge">@CartService.GetCount()</span>
                    }
                </a>
                <a asp-page="/Admin/Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 1 1 6 0v3zm3 4a2 2 0 0 1 1 3.7V19h-2v-1.3A2 2 0 0 1 12 14z" fill="currentColor"/></svg>
                    <span>Admin</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Account/Logout">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 7l-1.4 1.4L18.2 11H9v2h9.2l-2.6 2.6L17 17l5-5zM4 4h8v2H6v12h6v2H4z" fill="currentColor"/></svg>
                        <span>Sign out</span>
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p class="footer-brand">Sailabloom <span>by Sailaja</span> — Every Garden Begins with Love.</p>
            <p>
                <a asp-page="/Guarantee">Arrive-Alive Guarantee &amp; Refunds</a> ·
                <a asp-page="/Shop">Shop plants</a> ·
                <a asp-page="/Admin/Index">Admin</a>
            </p>
            <p class="muted">Home-grown plants from our greenhouse to your home. Demo checkout — no real payments are processed.</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
